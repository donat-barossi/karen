[Unit]
Description=Karen Whisper ASR HTTP (Jetson)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/donat/karen/jetson
Environment=KAREN_PROFILE=jetson
Environment=PYTHONUNBUFFERED=1
Environment=LD_LIBRARY_PATH=/home/donat/.local/lib:/usr/lib/aarch64-linux-gnu/openblas-pthread:/usr/local/cuda/lib64
Environment=PATH=/usr/local/cuda/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/home/donat/karen/jetson/venv/bin/python scripts/whisper_asr_server.py --host 0.0.0.0 --port 9000
Restart=always
RestartSec=10
StandardOutput=append:/home/donat/karen/jetson/whisper-asr.log
StandardError=append:/home/donat/karen/jetson/whisper-asr.log

[Install]
WantedBy=default.target

# Jarvis – override configurazione locale
#
# Profili condivisi in host/config/
#   base.yaml      → transport, HA, modelli, assistant Jarvis, TTS Giorgio
#   topgro.yaml    → PC gaming TOPGRO (consigliato)
#   jetson.yaml    → Jetson Orin Nano
#
# Avvio:
#   KAREN_PROFILE=topgro python3 main.py
#
# Copia come config.local.yaml (token HA, IP ESP32 — non committare segreti)

transport:
  esp32_ip: "192.168.1.89"

ha:
  token: "YOUR_HA_LONG_LIVED_TOKEN"

weather:
  latitude: 41.6488
  longitude: -0.8891
  default_city: "Zaragoza"
  timezone: "Europe/Madrid"
